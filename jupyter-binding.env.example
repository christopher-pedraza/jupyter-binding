# Copy to jupyter-binding.env (git-ignored) and edit. Plain shell syntax.
# Priority: flags > JB_* environment variables > this file > defaults.

# --- connection ---
JB_TARGET="username@login.your-cluster.edu"
#JB_SSH_KEY="$HOME/.ssh/id_ed25519"
#JB_SSH_EXTRA="-J jumphost.example.edu"     # e.g. a bastion / ProxyJump

# --- local side ---
JB_LOCAL_PORT=8080
# 127.0.0.1 = only this machine. 0.0.0.0 = other machines on your LAN can connect
# (they still need the token, but anyone on the LAN who has the URL can run code).
JB_BIND_ADDRESS=127.0.0.1

# --- job resources (leave empty / commented to use cluster defaults) ---
JB_GRES="gpu:1"            # e.g. gpu:v100:1 ; empty = no GPU
JB_TIME=02:00:00
#JB_MEM=32G
#JB_CPUS=4
#JB_PARTITION=
#JB_ACCOUNT=
#JB_JOB_NAME=jupyter_binding

# --- software environment on the compute node ---
JB_CONDA_ENV="base"
#JB_SETUP_CMD="module load python; source ~/venvs/ml/bin/activate"
#JB_JUPYTER_CMD="jupyter lab"

# --- monitoring ---
#JB_WARN_MINUTES=10      # warn when this many minutes remain; 0 = off (default)
#JB_CHECK_SECS=30        # how often the running job is checked (one small squeue call)
